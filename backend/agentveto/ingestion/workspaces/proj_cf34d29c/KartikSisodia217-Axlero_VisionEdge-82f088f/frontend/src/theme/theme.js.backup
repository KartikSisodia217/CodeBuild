import { createTheme } from "@mui/material/styles";

const getTheme = (mode = "light") => {
  const isDark = mode === "dark";

  return createTheme({
    palette: {
      mode,

      primary: {
        main: "#2563eb",
      },

      secondary: {
        main: "#7c3aed",
      },

      success: {
        main: "#16a34a",
      },

      warning: {
        main: "#f59e0b",
      },

      error: {
        main: "#dc2626",
      },

      background: {
        default: isDark ? "#0f172a" : "#f8fafc",
        paper: isDark ? "#111827" : "#ffffff",
      },

      text: {
        primary: isDark ? "#f8fafc" : "#0f172a",
        secondary: isDark ? "#94a3b8" : "#64748b",
      },

      divider: isDark ? "#334155" : "#e2e8f0",
    },

    typography: {
      fontFamily: [
        "Inter",
        "Roboto",
        "Arial",
        "sans-serif",
      ].join(","),
    },

    shape: {
      borderRadius: 12,
    },

    components: {
      MuiCard: {
        styleOverrides: {
          root: {
            backgroundImage: "none",
          },
        },
      },

      MuiButton: {
        styleOverrides: {
          root: {
            textTransform: "none",
            fontWeight: 600,
            borderRadius: 10,
          },
        },
      },

      MuiSwitch: {
        styleOverrides: {
          switchBase: {
            "&.Mui-checked": {
              color: "#2563eb",
            },

            "&.Mui-checked + .MuiSwitch-track": {
              backgroundColor: "#2563eb",
            },
          },
        },
      },
    },
  });
};

export default getTheme;